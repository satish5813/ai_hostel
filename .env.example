# copy to .env (API) and apps/web/.env.local (web) and fill in
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/klu_hostel
API_PORT=4000
# auth: OIDC issuer (Keycloak realm) — leave empty to use the DEV header auth (x-dev-user / x-dev-role)
OIDC_ISSUER=
OIDC_AUDIENCE=klu-hostel
# payments (Razorpay test keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Yearly renewal: Room Allotment can continue a stay from 15 days before the new year starts. 1 lifts that for testing only.
RENEWAL_CONTINUE_ANYTIME=0

# Demo sign-in for training (never in production): accounts from db/seed/demo_logins.sql, one shared password shown as the hint.
DEMO_LOGIN=0
DEMO_PASSWORD_HINT=
